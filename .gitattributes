# Line endings — PRECISA ser o primeiro commit do repo.
# Um .sh com CRLF morre dentro do WSL com `$'\r': command not found`,
# e o erro não diz nada sobre line ending. Um .ps1/.xml com LF pode
# quebrar em ferramentas antigas do Windows.

* text=auto

*.sh   text eol=lf
*.bash text eol=lf
*.conf text eol=lf
# Precisa do glob: o padrao `user-data` sozinho NAO casa com `cloud-init.user-data`.
# Sem isso o arquivo cai no `* text=auto`, um clone no Windows (Git for Windows
# instala com core.autocrlf=true) o materializa com CRLF, e o header `#cloud-config`
# com \r vira no-op silencioso — o cloud-init simplesmente nao roda.
*.user-data text eol=lf

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.xml  text eol=crlf
*.reg  text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.iso binary
